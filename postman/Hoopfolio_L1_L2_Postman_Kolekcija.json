{
  "info": {
    "name": "Hoopfolio L1 + L2 | API testai",
    "description": "19 L1 ir 20 L2 užklausų. Paleidimas: Postman Collection Runner, 1 iteracija. Prieš vykdymą Variables skiltyje nustatyti adminPassword ir analystPassword. Testiniai stebėjimo sąrašai pašalinami automatiškai; registruota reader paskyra lieka DB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 | JWT prisijungimas (3)",
      "description": "Prisijungimas kaip admin ir JWT paruošimas L1 testams.",
      "item": [
        {
          "name": "01. GET – Be JWT (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://127.0.0.1:8000/watchlists",
            "description": "401; be JWT negalima peržiūrėti sąrašų.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"adminToken\");",
                  "pm.collectionVariables.unset(\"adminRefreshToken\");",
                  "pm.collectionVariables.unset(\"adminId\");",
                  "pm.collectionVariables.unset(\"readerEmail\");",
                  "pm.collectionVariables.unset(\"readerToken\");",
                  "pm.collectionVariables.unset(\"analystToken\");",
                  "pm.collectionVariables.unset(\"analystId\");",
                  "pm.collectionVariables.unset(\"adminWatchlistId\");",
                  "pm.collectionVariables.unset(\"analystWatchlistId\");",
                  "pm.collectionVariables.unset(\"oldRefreshToken\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02. POST – Prisijungti kaip admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://127.0.0.1:8000/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "200; prisijungiama kaip admin, išsaugomi access ir refresh žetonai."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"adminToken\", pm.response.json().access_token);",
                  "    pm.collectionVariables.set(\"adminRefreshToken\", pm.response.json().refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03. GET – Prisijungęs admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://127.0.0.1:8000/auth/me",
            "description": "200; patikrinama admin rolė, išsaugomas adminId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK: admin rolė\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().role).to.eql(\"admin\");",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"adminId\", String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
