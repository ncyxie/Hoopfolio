        {
          "name": "16. GET – Suvestinė",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard",
            "description": "Tikrina suvestinės sumas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statusas: 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.test('Suvestinės sumos', function () {",
                  "        pm.expect(data.watchlists).to.be.an('array');",
                  "        pm.expect(data.total_watchlists).to.eql(data.watchlists.length);",
                  "        pm.expect(data.total_entries).to.eql(data.watchlists.reduce((sum, w) => sum + w.entries_count, 0));",
                  "        pm.expect(data.total_reports).to.eql(data.watchlists.reduce((sum, w) => sum + w.reports_count, 0));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
