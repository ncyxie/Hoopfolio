        {
          "name": "01. POST – Sukurti sąrašą",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/watchlists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman L1 bandomasis sąrašas\",\n  \"purpose\": \"Automatinis Hoopfolio L1 CRUD testas\",\n  \"owner_name\": \"Postman testas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sukuria stebėjimo sąrašą; išsaugo watchlistId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statusas: 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('watchlistId', String(data.id));",
                  "    pm.test('ID ir _links.self', function () {",
                  "        pm.expect(data.id).to.be.a('number');",
                  "        pm.expect(data._links.self).to.eql('/watchlists/' + data.id);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
