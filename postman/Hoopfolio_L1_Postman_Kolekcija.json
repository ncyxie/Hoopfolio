                "value": "application/json"
              }
            ],
            "url": "http://127.0.0.1:8000/watchlists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman L1\",\n  \"purpose\": \"REST API CRUD testas\",\n  \"owner_name\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201; sukuriamas sąrašas, išsaugomas watchlistId."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"watchlistId\");",
                  "pm.collectionVariables.unset(\"entryId\");",
                  "pm.collectionVariables.unset(\"reportId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"watchlistId\", String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ]
        },
